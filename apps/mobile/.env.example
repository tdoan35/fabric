# Base URL of the Fabric server as the phone reaches it — not localhost (that's the phone itself).
# MOBILE-PLAN §4: prefer the laptop's hotspot IP or the Tailscale 100.x address; a public tunnel
# exposes an unauthenticated server, so shut it down after use.
# Metro inlines EXPO_PUBLIC_* when the dev server starts: restart `npm start` after editing.
EXPO_PUBLIC_API_URL=http://192.168.1.2:8787
