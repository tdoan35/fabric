# Copy to .env (never commit it). Each worktree copies the root .env and sets its own ports.
# Names are ours, not the sponsors'. Every integration is optional: the server boots without it.

# --- ports (worktree index n: web 3000+10n, server 8787+10n) ---
PORT=8787
VITE_PORT=3000

# --- web (Vite exposes only VITE_* to the browser) ---
VITE_API_MODE=mock            # mock | http
VITE_API_URL=http://localhost:8787
VITE_DEMO=0                   # 1 hides group chat, Full auto, voice, the 1M meter; locks Runs on (D7)

# --- server ---
CORS_ORIGINS=                 # comma-separated; default: the local web origin + app://fabric
# `neon link --branch <name>` writes the next three for that branch (production | demo | recording | ws-<code>)
DATABASE_URL=                 # pooled
DATABASE_URL_UNPOOLED=        # direct, for migrations
NEON_BRANCH=
NEON_AI_GATEWAY_BASE_URL=     # Neon's names; paid plan only (neon env pull fills them once enabled)
NEON_AI_GATEWAY_TOKEN=
LLM_PROVIDER=spark            # spark (dev, free) | openrouter (backup, paid) | neon (venue, Gateway credits)
SPARK_BASE_URL=               # e.g. http://<spark-host>:18300/v1 (tailnet only)
SPARK_API_KEY=                # not enforced by the vLLM server; the tailnet is the boundary
SPARK_MODEL=qwen3.8-flash-next
OPENROUTER_API_KEY=
SPRITES_TOKEN=                # org-slug/org-id/token-id/token-value (Fly dashboard → Sprites → Tokens)
SPRITE_CODER=fabric-coder
SPRITE_VALIDATOR=fabric-validator
SPRITE_ASSISTANT=fabric-assistant
# Provision Dana once: bash scripts/setup-dana-sprite.sh (headed Chromium, persistent profile).
# Browser egress uses a public-only validating proxy + browser-UID firewall, not DNS rules.
# This boundary is the browser UID; privileged Sprite exec remains trusted and can change firewall rules.
# noVNC remains Sprite-authenticated and view-only; Session uses screenshots if embedding needs login.
BROWSER_CONFIRM_BEFORE_SUBMIT=false # optional final-reservation approval gate; real submissions default on
EXA_API_KEY=
AGENTMAIL_API_KEY=
EXECUTOR_URL=                 # Executor Cloud MCP endpoint, e.g. https://executor.sh/<org>/mcp
EXECUTOR_KEY=                 # OAuth bearer/refresh token; the hosted endpoint has no static keys (S6)
DANA_MODE=live                # live | fixture
# S5 runtime (durable sessions): the event log, queue and workers the server hosts in-process.
RUNTIME_DATABASE_URL=         # direct (unpooled) Postgres; unset = PGlite at RUNTIME_PGLITE_DIR
RUNTIME_PGLITE_DIR=           # default .data/runtime
RUNTIME_CONCURRENCY=          # worker job concurrency; default 4
MODEL_PORT=                   # ai (default) | test (CI/smoke echo double; refused when NODE_ENV=production)
# T14 session tools: per-agent work dirs under FABRIC_WORK_DIR/agents/<id>, the
# vault's master key file, and the identity `send` sends from (unset = no `send`).
FABRIC_WORK_DIR=
FABRIC_MASTER_KEY_FILE=
FABRIC_SEND_FROM=
# M7 MCP OAuth: the public origin providers redirect back to (<origin>/api/mcp/oauth/callback);
# unset = http://localhost:<PORT>.
#FABRIC_PUBLIC_URL=
FEATURE_AGENTMAIL=off         # on | off
FEATURE_EXECUTOR=off
DEMO_RECORDING_KEY=ngram-135m
OWNER_EMAIL=
SEED_PROFILE=demo             # demo | lived-in
