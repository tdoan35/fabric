# Copy to .env (never commit it). Each worktree copies the root .env and sets its own ports (WORK-PLAN §4.9).
# Names are ours, not the sponsors'. Every integration is optional: the server boots without it.

# --- ports (worktree index n: web 3000+10n, server 8787+10n) ---
PORT=8787
VITE_PORT=3000

# --- web (Vite exposes only VITE_* to the browser) ---
VITE_API_MODE=mock            # mock | http
VITE_API_URL=http://localhost:8787
VITE_DEMO=0                   # 1 hides group chat, Full auto, voice, the 1M meter; locks Runs on (D7)

# --- server ---
CORS_ORIGINS=                 # comma-separated; default: the local web origin + app://fabric
DATABASE_URL=                 # Neon branch: main | demo | recording | ws-<code>
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
LLM_FALLBACK_PROVIDER=        # used only if S1 fails
LLM_FALLBACK_KEY=
SPRITES_TOKEN=
EXA_API_KEY=
AGENTMAIL_API_KEY=
EXECUTOR_URL=
EXECUTOR_KEY=
DANA_MODE=live                # live | fixture
FEATURE_AGENTMAIL=off         # on | off
FEATURE_EXECUTOR=off
DEMO_RECORDING_KEY=ngram-135m
OWNER_EMAIL=
SEED_PROFILE=demo             # demo | lived-in
