# dependencies
node_modules/

# builds
dist/
release/
*.AppImage
*.tsbuildinfo
coverage/

# env and secrets
.env
.env.*
!.env.example
*.pem

# memory sources: the Mnemosyne store holds PII and must never enter the repo (MEM)
*.db
mnemosyne/

# local tooling
chrome-profile/
.DS_Store
# runtime state: the server's .data dir (pglite fallback, master key, work dirs)
# is created at runtime — the master key must be 0600 on first boot, which a git
# checkout (644) would break (V10's strict mode check).
.data/
npm-debug.log*
# tools: exa result cache (the fallback when Exa is slow or down)
.cache/

# exported git history, if any
*.bundle
.neon
.claude/settings.local.json
