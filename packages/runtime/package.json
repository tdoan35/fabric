{
  "name": "@fabric/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime R5 storage: durable event-log streams on PGlite and Postgres — append with head bumps, facts-only causation dedupe, commit-time notify and the enqueue port, readStream (RUNTIME 2).",
