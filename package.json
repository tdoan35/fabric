{
  "name": "fabric",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run dev -w @fabric/server",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:chat": "tsx scripts/check-chat.ts",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint -w web",
    "seed": "npm run seed -w @fabric/db --",
    "memory:import": "tsx scripts/import-mnemosyne.ts",
    "smoke": "node scripts/smoke.mjs",
    "llm:check": "tsx scripts/llm-check.ts",
    "export-recording": "tsx scripts/export-recording.ts",
    "check:data": "node scripts/check-data.mjs",
    "check:tools": "tsx scripts/check-tools.ts",
    "check:team": "tsx scripts/check-team.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
